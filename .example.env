# Copy to .env and fill in real values. .env is gitignored and must never be
# committed. In production these are injected at run time by the orchestrator,
# not baked into the image.

# --- Tile Server DB (destination: schema pwfsl_map) ---
TS_DB_HOST=your-ts-db-host.example.com
TS_DB_PORT=5432
TS_DB_USER=changeme
TS_DB_PW=changeme
TS_DB_DATABASE=changeme

# --- AirFire DB (source: holds both the fire_info AND outlook_v7 schemas) ---
AIRFIRE_DB_HOST=your-airfire-db-host.example.com
AIRFIRE_DB_PORT=5432
AIRFIRE_DB_USER=changeme
AIRFIRE_DB_PW=changeme
AIRFIRE_DB_DATABASE=changeme

# --- AirFire S3 (source data) ---
AWS_ACCESS_KEY=changeme
AWS_SECRET_ACCESS_KEY=changeme
AFE_BUCKET=your-airfire-exports-bucket
# Optional: point at a non-AWS / S3-compatible store. Leave unset for AWS.
# AWS_ENDPOINT_URL=https://s3.us-west-2.amazonaws.com
# AWS_REGION=us-west-2

# --- EPA S3 (HMS status / layer artifacts) ---
EPA_AWS_ACCESS_KEY=changeme
EPA_AWS_SECRET_ACCESS_KEY=changeme
EPA_BUCKET=your-epa-layers-bucket
# EPA_ENDPOINT_URL=
# EPA_REGION=

# ============================================================================
# Optional data source/target overrides.
# Every line below is OPTIONAL — unset, the value shown (the current default)
# is used. Uncomment and change to repoint a source/target without a code
# change. Table names must be plain SQL identifiers (no schema prefix, no dots).
# ============================================================================

# --- Schemas ---
# DEST_SCHEMA=pwfsl_map          # all streams write here
# FIRE_SCHEMA=fire_info          # fire source (AirFire DB)
# OUTLOOK_SCHEMA=outlook_v7      # outlook source
# NOTE: the historical-aq-sync .sql files hardcode pwfsl_map/pwfsl_historical
# internally, so DEST_SCHEMA does NOT repoint that stream — edit the SQL for it.

# --- S3 source object keys ---
# AIRNOW_S3_KEY=monitoring/v2/latest/geojson/fasm_airnow_PM2.5_latest.geojson
# CLARITY_S3_KEY=sensors/v3/PM2.5/latest/geojson/fasm_clarity_PM2.5_latest.geojson
# AIRSIS_S3_KEY=monitoring/v2/latest/geojson/fasm_airsis_PM2.5_latest.geojson
# WRCC_S3_KEY=monitoring/v2/latest/geojson/fasm_wrcc_PM2.5_latest.geojson
# PURPLE_AIR_S3_KEY=maps/purple_air/v4/pas.csv
# HMS_FIRE_S3_KEY=hms/v1/geojson/latest_fire.geojson
# HMS_SMOKE_S3_KEY=hms/v1/geojson/latest_smoke.geojson
# PURPLE_AIR_EXCLUSION_S3_KEY=maps/exclusion_lists/purple_air.json
# ELWOOD_EXCLUSION_S3_KEY=elwood/exclusion_lists/elwood_exclusion.json

# --- S3 output object keys ---
# OUTLOOKS_OUTPUT_S3_KEY=outlooks/published_outlooks.geojson
# HMS_STATUS_S3_KEY=status/hms_status.json

# --- Destination tables (unqualified; written under DEST_SCHEMA) ---
# AIRNOW_TABLE=airnow_monitors
# CLARITY_TABLE=clarity_sensors
# AIRSIS_TABLE=airsis_monitors
# WRCC_TABLE=wrcc_monitors
# PURPLE_AIR_TABLE=purple_air
# FIRE_POINTS_TABLE=fasm_fire_points
# FIRE_PERIMETERS_TABLE=fasm_fire_perimeters
# FIRE_DETECTS_TABLE=fire_detects
# FIRE_DETECTS_GRID_TABLE=fire_detects_historical_grid
# HMS_SMOKE_TABLE=hms_smoke_plume
# OUTLOOKS_TABLE=outlooks
# PURPLE_AIR_EXCLUSION_TABLE=purple_air_exclusion
# ELWOOD_EXCLUSION_TABLE=elwood_exclusion

# --- Prefect (only needed when deploying / running a worker locally) ---
PREFECT_API_URL=https://prefect.airfire.org/api
